# Copy to .env. See docs/ARCHITECTURE.md §17.
# App connects as the non-owner role so RLS applies; migrations/seed use the owner (direct) URL.
DATABASE_URL=postgresql://app_user:app_user@localhost:5432/countersign
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/countersign

ANTHROPIC_API_KEY=
LLM_MODE=live            # live | record | replay (tests default to replay)

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

ENCRYPTION_KEY=          # 32 bytes, base64: openssl rand -base64 32

QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/api/connections/qbo/callback
QBO_ENV=sandbox          # sandbox | production
QBO_WEBHOOK_VERIFIER=

# Auth (provider decided in docs/plan.md §1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

RESEND_API_KEY=          # optional; v1 doc requests are inbox-only
