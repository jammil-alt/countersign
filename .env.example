# Copy to .env. See docs/ARCHITECTURE.md §17 and docs/plan.md §1.
# App connects as the non-owner role so RLS applies; migrations/seed use the owner (direct) URL.
# Deployed: DATABASE_URL is reached through Hyperdrive (pooled Neon); DIRECT_DATABASE_URL is Neon direct.
DATABASE_URL=postgresql://app_user:app_user@localhost:5432/countersign
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/countersign

ANTHROPIC_API_KEY=
LLM_MODE=live            # live | record | replay (tests default to replay)

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

STORAGE_ENDPOINT=         # R2: https://<account id>.r2.cloudflarestorage.com
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

ENCRYPTION_KEY=          # 32 bytes, base64: openssl rand -base64 32

QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/api/connections/qbo/callback
QBO_ENV=sandbox          # sandbox | production
QBO_WEBHOOK_VERIFIER=

# Auth (docs/plan.md §1.1): workos in deployed envs, dev locally
AUTH_PROVIDER=dev         # dev | workos
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=   # seals the session cookie; long random string

RESEND_API_KEY=          # optional; v1 doc requests are inbox-only
