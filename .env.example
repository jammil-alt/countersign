# Copy to .env (gitignored). Local values match docs/local-development.md; deployed values are
# Worker secrets and bindings (docs/operations.md §1), never this file.
#
# Roles (docs/plan.md §1.2): cs_owner runs migrations and the seed; the Worker logs in as cs_worker
# (member of cs_runtime only, so row-level security applies).
DIRECT_DATABASE_URL=postgresql://cs_owner:cs_owner@localhost:5432/countersign
# wrangler dev reads this in place of the HYPERDRIVE binding:
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://cs_worker:cs_worker@localhost:5432/countersign
# Throwaway databases for tests are created through this superuser connection:
TEST_ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

ANTHROPIC_API_KEY=
LLM_MODE=live             # live | record | replay (tests default to replay)

STORAGE_ENDPOINT=         # R2 S3 API, for signed URLs: https://<account id>.r2.cloudflarestorage.com
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

ENCRYPTION_KEY=           # 32 bytes, base64: openssl rand -base64 32

QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:8787/api/connections/qbo/callback
QBO_ENV=sandbox           # sandbox | production
QBO_WEBHOOK_VERIFIER=

# Gmail connector (M10): a Google Cloud OAuth client (docs/operations.md §1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/connections/gmail/callback

# Auth (docs/plan.md §1.1): workos in deployed envs, dev locally
AUTH_PROVIDER=dev         # dev | workos
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=   # seals the session cookie; long random string

RESEND_API_KEY=           # optional; v1 doc requests are inbox-only
