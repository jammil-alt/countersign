# Copy to .env (gitignored). Local values match docs/local-development.md; deployed values are
# Worker secrets and bindings (docs/operations.md §1), never this file.
#
# Roles (docs/plan.md §1.2): cs_owner runs migrations and the seed; the Worker logs in as cs_worker
# (member of cs_runtime only, so row-level security applies).
DIRECT_DATABASE_URL=postgresql://cs_owner:cs_owner@localhost:5432/countersign
# wrangler dev reads this in place of the HYPERDRIVE binding:
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://cs_worker:cs_worker@localhost:5432/countersign
# Throwaway databases for tests are created through this superuser connection:
TEST_ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

ANTHROPIC_API_KEY=
LLM_MODE=live             # live | record | replay (tests default to replay)

STORAGE_ENDPOINT=         # R2 S3 API, for signed URLs: https://<account id>.r2.cloudflarestorage.com
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

ENCRYPTION_KEY=           # 32 bytes, base64: openssl rand -base64 32

QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:8787/api/connections/qbo/callback
QBO_ENV=sandbox           # sandbox | production
QBO_WEBHOOK_VERIFIER=

# Signing in to tools from the portal (OAuth): signs the state; at least 32 random bytes
OAUTH_STATE_SECRET=       # openssl rand -base64 48
APP_ORIGIN=http://localhost:8787   # where providers send the client back (/connections/<connector>/callback)

# Zoho CRM (owner, 2026-11-04): a Server-based client in Zoho's API console, multi-DC on, with
# redirect URI <APP_ORIGIN>/connections/zoho_crm/callback (docs/connect-zapier.md has the webhooks how-to)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Podio (owner, 2026-11-04): an API key from Podio, redirect URI <APP_ORIGIN>/connections/podio/callback
PODIO_CLIENT_ID=
PODIO_CLIENT_SECRET=

# Billing (stream J): Mezonas' own Stripe account, test mode locally; never commit a key
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email forwarding (MVP): inbound domain routed to the Worker; locally, tests feed .eml fixtures instead
EMAIL_FORWARDING_DOMAIN=

# Gmail connector (M10, after the MVP): a Google Cloud OAuth client (docs/operations.md §1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/connections/gmail/callback

# Auth (docs/plan.md §1.1): workos in deployed envs, dev locally
AUTH_PROVIDER=dev         # dev | workos
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=   # seals the session cookie (and MCP confirm tokens); long random string
# The back office's MCP server at <APP_ORIGIN>/mcp (docs/operations.md, "MCP server"): this
# environment's AuthKit domain. Empty: /mcp is off (the default locally). Deployed values are vars
# in apps/api/wrangler.jsonc, not secrets.
WORKOS_AUTHKIT_DOMAIN=    # e.g. https://<name>.authkit.app
MCP_AUDIENCE=             # optional; what an MCP access token's aud must contain (default <APP_ORIGIN>/mcp)

RESEND_API_KEY=           # optional; v1 doc requests are inbox-only
