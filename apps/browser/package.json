{
  "name": "@countersign/browser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The browser service (Worker mezonas-browser): Cloudflare Browser Run and Playwright for website logins and browser tool calls, reached only by apps/api's BROWSER service binding. Decides nothing.",
  "scripts": {
    "typecheck": "wrangler types && tsc -p .",
    "test": "vitest run --passWithNoTests && vitest run --config vitest.workers.config.ts",
    "dev": "wrangler dev",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/playwright": "1.3.6",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@countersign/connectors": "workspace:*",
    "@countersign/core": "workspace:*",
    "@types/node": "^22.20.2",
    "playwright": "1.64.1",
    "vitest": "^4.1.11",
    "wrangler": "4.157.0"
  }
}
