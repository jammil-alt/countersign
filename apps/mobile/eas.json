{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_ORIGIN": "https://staging.mezonas.com" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_ORIGIN": "https://staging.mezonas.com" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_ORIGIN": "https://app.mezonas.com" }
    }
  },
  "submit": {
    "production": {}
  }
}
