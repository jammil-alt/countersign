{
  "name": "@countersign/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Mezonas phone app (Expo, iOS and Android): Your Desk, signing with Face ID or a fingerprint, notifications, phones. Imports only @countersign/core and the design system's tokens.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "tokens": "node scripts/tokens.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@countersign/core": "workspace:*",
    "@countersign/design-system": "workspace:*",
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@expo/metro-runtime": "~58.0.17",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "expo": "58.0.24",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.19",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "vitest": "^5.0.0"
  }
}
