{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The public site (docs/plan.md §1.29): static assets only, no Worker code. Built into dist/ by
  // build.mjs. One site for every environment, deployed from main by deploy.yml (job `site`).
  "name": "mezonas-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // /terms serves terms.html; /terms/ and /terms.html redirect to /terms.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Nothing public but the custom domains below: no workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // `wrangler deploy` creates both records and certificates on the mezonas.com zone. It cannot
  // attach while another DNS record holds the name (docs/operations.md, "The public site").
  // DECISION: www serves the same pages, each with a canonical link to the apex, instead of a
  // redirect: a host redirect needs Worker code or a zone rule, and this Worker has no code. A
  // Redirect Rule from www to the apex can be added in the dashboard at any time (operations.md).
  "routes": [
    { "pattern": "mezonas.com", "custom_domain": true },
    { "pattern": "www.mezonas.com", "custom_domain": true }
  ]
}
