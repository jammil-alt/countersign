{
  "name": "@countersign/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Mezonas desktop app (Electron, Mac and Windows): folders a client gives Mezonas, jobs on those files, notifications and the Desk. Imports only @countersign/core and the design system.",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "dist": "node scripts/build.mjs && pnpm dlx electron-builder@26.18.0 --config electron-builder.yml",
    "typecheck": "tsc -p .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@countersign/core": "workspace:*",
    "@countersign/design-system": "workspace:*",
    "@xmldom/xmldom": "^0.9.12",
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.3.3",
    "esbuild": "^0.28.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.0"
  }
}
