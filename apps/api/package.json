{
  "name": "@countersign/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hono Worker: /api routes, auth, static assets, Workflow classes, cron; registers connectors and packs",
  "scripts": {
    "typecheck": "wrangler types && tsc -p .",
    "test": "vitest run --passWithNoTests && vitest run --config vitest.workers.config.ts",
    "dev": "wrangler dev --env-file ../../.env",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/playwright": "1.3.6",
    "@countersign/agents": "workspace:*",
    "@countersign/auth": "workspace:*",
    "@countersign/connectors": "workspace:*",
    "@countersign/core": "workspace:*",
    "@countersign/db": "workspace:*",
    "@countersign/documents": "workspace:*",
    "@countersign/llm": "workspace:*",
    "@countersign/pack-materials": "workspace:*",
    "@countersign/senses": "workspace:*",
    "@countersign/threads": "workspace:*",
    "@countersign/workflows": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
    "@sentry/cloudflare": "11.2.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "jose": "^6.2.15",
    "pdf-lib": "1.17.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^22.20.2",
    "playwright": "1.63.0",
    "vitest": "^4.1.11",
    "wrangler": "4.131.0"
  }
}
