{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Top level = local development only (`wrangler dev`, the Workers tests). It is never deployed:
  // deploy.yml always passes --env=staging or --env=production, so the dev sign-in below can't reach
  // a real domain. Public resources are named Mezonas; the code name stays countersign.
  "name": "mezonas-local",
  // src/worker.ts is src/index.ts with Sentry around it (inert without SENTRY_DSN).
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  // postgres-js needs Node's net/tls shims under Workers.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The web app is served from the same Worker; /api/* reaches the Worker first (docs/plan.md §1.1).
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // The senses sweep and schedule check run every minute (docs/plan.md §1.2).
  "triggers": { "crons": ["* * * * *"] },

  // Neon through Hyperdrive, as cs_worker (docs/plan.md §1.1). Locally, `wrangler dev` and the
  // Workers tests read CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE instead (.env.example),
  // so this id is never used.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }],

  // Original documents and other files. Local R2 simulation under `wrangler dev`.
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "mezonas-local" }],

  // One Workflow class runs any workflow of any client agent; the instance id is the run id
  // (ARCHITECTURE §10.3).
  "workflows": [
    { "name": "mezonas-local-run", "binding": "RUN_WORKFLOW", "class_name": "RunWorkflow" }
  ],

  // Non-secret configuration. Secrets (WORKOS_API_KEY, WORKOS_COOKIE_PASSWORD, ANTHROPIC_API_KEY,
  // ENCRYPTION_KEY) are set with `wrangler secret put`, or in apps/api/.dev.vars locally, never here.
  "vars": {
    // development | staging | production. The dev sign-in adapter refuses to run in production.
    "ENVIRONMENT": "development",
    // dev | workos (docs/plan.md §1.1 "Auth provider").
    "AUTH_PROVIDER": "dev",
    // Empty: WorkOS sign-in is off.
    "WORKOS_CLIENT_ID": "",
    "APP_ORIGIN": "http://localhost:8787",
    // live | record | replay. The Worker only ever calls the model live; tests use replay or fakes.
    "LLM_MODE": "live"
  },

  // Each environment repeats every binding: wrangler does not inherit bindings into an environment.
  // Resource names match .github/workflows/bootstrap.yml; domains are on the mezonas.com zone
  // (docs/operations.md, "Environments"). `CODES` (the code service, apps/mfa) is bound in the
  // deployed environments only: locally it is absent and the code service is off.
  "env": {
    "staging": {
      "name": "mezonas-staging",
      "routes": [{ "pattern": "staging.mezonas.com", "custom_domain": true }],
      "triggers": { "crons": ["* * * * *"] },
      // Hyperdrive `mezonas-db-staging` (Neon branch staging), from Bootstrap cloud.
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "934bb30230e344539da6ab05c4447ec6" }],
      "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "mezonas-staging" }],
      "workflows": [
        { "name": "mezonas-staging-run", "binding": "RUN_WORKFLOW", "class_name": "RunWorkflow" }
      ],
      // The code service (apps/mfa), its RPC entry point only. deploy.yml deploys it first.
      "services": [
        { "binding": "CODES", "service": "mezonas-codes-staging", "entrypoint": "Codes" }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "AUTH_PROVIDER": "workos",
        // WorkOS "Mezonas Staging" app, Staging environment. Client ids are not secrets.
        "WORKOS_CLIENT_ID": "client_01M6HNS5BGAXTK0TK2A1RRGWGP",
        "APP_ORIGIN": "https://staging.mezonas.com",
        "LLM_MODE": "live"
      }
    },
    "production": {
      "name": "mezonas",
      "routes": [{ "pattern": "app.mezonas.com", "custom_domain": true }],
      "triggers": { "crons": ["* * * * *"] },
      // Hyperdrive `mezonas-db` (Neon branch main), from Bootstrap cloud.
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "b4032076210742cb961ccc2fc1bdf282" }],
      "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "mezonas" }],
      "workflows": [
        { "name": "mezonas-run", "binding": "RUN_WORKFLOW", "class_name": "RunWorkflow" }
      ],
      "services": [{ "binding": "CODES", "service": "mezonas-codes", "entrypoint": "Codes" }],
      "vars": {
        "ENVIRONMENT": "production",
        "AUTH_PROVIDER": "workos",
        // PLACEHOLDER: the production WorkOS client id, set when WorkOS is provisioned.
        "WORKOS_CLIENT_ID": "",
        "APP_ORIGIN": "https://app.mezonas.com",
        "LLM_MODE": "live"
      }
    }
  }
}
