{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "countersign",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // postgres-js needs Node's net/tls shims under Workers.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The web app is served from the same Worker; /api/* reaches the Worker first (docs/plan.md §1.1).
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // The senses sweep and schedule check run every minute (docs/plan.md §1.2).
  "triggers": { "crons": ["* * * * *"] },

  // Neon through Hyperdrive, as cs_worker (docs/plan.md §1.1). PLACEHOLDER id: the Bootstrap cloud
  // workflow creates the real config (docs/operations.md). Locally, `wrangler dev` and the Workers
  // tests read CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE instead (.env.example).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }],

  // Original documents and other files. Local R2 simulation under `wrangler dev`.
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "countersign-artifacts" }],

  // One Workflow class runs any workflow of any client agent; the instance id is the run id
  // (ARCHITECTURE §10.3).
  "workflows": [
    { "name": "countersign-run", "binding": "RUN_WORKFLOW", "class_name": "RunWorkflow" }
  ],

  // Non-secret configuration. Secrets (WORKOS_API_KEY, WORKOS_COOKIE_PASSWORD, ANTHROPIC_API_KEY,
  // ENCRYPTION_KEY) are set with `wrangler secret put`, or in apps/api/.dev.vars locally, never here.
  "vars": {
    // development | staging | production. The dev sign-in adapter refuses to run in production.
    "ENVIRONMENT": "development",
    // dev | workos (docs/plan.md §1.1 "Auth provider").
    "AUTH_PROVIDER": "dev",
    // Empty: WorkOS sign-in is off.
    "WORKOS_CLIENT_ID": "",
    "APP_ORIGIN": "http://localhost:8787",
    // live | record | replay. The Worker only ever calls the model live; tests use replay or fakes.
    "LLM_MODE": "live"
  },

  "env": {
    // Mirrors every binding above: wrangler does not inherit bindings into an environment.
    "staging": {
      "name": "countersign-staging",
      "triggers": { "crons": ["* * * * *"] },
      // PLACEHOLDER id, as above.
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }],
      "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "countersign-staging-artifacts" }],
      "workflows": [
        {
          "name": "countersign-staging-run",
          "binding": "RUN_WORKFLOW",
          "class_name": "RunWorkflow"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "AUTH_PROVIDER": "workos",
        // PLACEHOLDER: the staging WorkOS client id and origin are set when WorkOS is provisioned.
        "WORKOS_CLIENT_ID": "",
        "APP_ORIGIN": "https://staging.countersign.example",
        "LLM_MODE": "live"
      }
    }
  }
}
