{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "countersign",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // postgres-js needs Node's net/tls shims under Workers.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The web app is served from the same Worker; /api/* reaches the Worker first (docs/plan.md §1.1).
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // The senses sweep and schedule check run every minute (docs/plan.md §1.2).
  "triggers": { "crons": ["* * * * *"] }

  // Hyperdrive, R2 and the RunWorkflow binding are added with the code that uses them.
}
