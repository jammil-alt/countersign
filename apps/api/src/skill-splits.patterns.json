  "invoice": {
    "schemaVersion": 5,
    "triggers": [
      {
        "id": "trg-document",
        "on": {
          "type": "manual",
          "input": {
            "type": "object",
            "properties": {
              "documentId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": ["documentId"],
            "additionalProperties": false
          }
        }
      }
    ],
    "outputs": [
      {
        "id": "out-done",
        "name": "Done",
        "kind": "nothing"
      }
    ],
    "steps": [
      {
        "id": "read",
        "name": "Read the invoice",
        "client": {
          "visible": true,
          "label": "Read the invoice"
        },
        "kind": "do",
        "doneBy": "ai",
        "uses": {
          "type": "skill",
          "skill": "docs.read-document"
        },
        "input": {
          "documentId": "{{trigger.documentId}}"
        }
      },
      {
        "id": "totals",
        "name": "Check the totals",
        "client": {
          "visible": false
        },
        "kind": "do",
        "doneBy": "rules",
        "uses": {
          "type": "skill",
          "skill": "docs.check-totals"
        },
        "input": {
          "reading": "{{steps.read.output}}"
        }
      },
      {
        "id": "totals-off",
        "name": "Totals don't add up?",
        "kind": "fork",
        "paths": [
          {
            "id": "totals-off-path",
            "name": "They don't",
            "when": {
              "match": "all",
              "rules": [
                {
                  "field": "{{steps.totals.output.totalsMatch}}",
                  "op": "=",
                  "value": false
                }
              ]
            },
            "steps": [
              {
                "id": "totals-person",
                "name": "Ask a person to check the totals",
                "client": {
                  "visible": true,
                  "label": "Asked you to check an invoice's totals"
                },
                "kind": "do",
                "doneBy": "person",
                "person": {
                  "mode": "approve",
                  "who": "client_admin",
                  "question": "Check the totals on {{steps.totals.output.vendorName}} invoice {{steps.totals.output.invoiceNumber}}",
                  "show": {
                    "documentId": "{{trigger.documentId}}",
                    "problems": "{{steps.totals.output.problems}}"
                  },
                  "deadline": {
                    "after": "3 days",
                    "hours": "business",
                    "remind": ["1 day"],
                    "ifNoAnswer": "stop"
                  },
                  "channel": "inbox",
                  "onReject": "stop"
                }
              }
            ]
          }
        ],
        "otherwise": {
          "id": "totals-ok",
          "steps": []
        }
      },
      {
        "id": "save-reading",
        "name": "Save to records: the reading",
        "client": {
          "visible": false
        },
        "kind": "do",
        "doneBy": "rules",
        "uses": {
          "type": "action",
          "action": "docs.reading.record"
        },
        "input": {
          "documentId": "{{trigger.documentId}}",
          "reading": "{{steps.totals.output.reading}}"
        }
      },
      {
        "id": "lookup",
        "name": "Look up existing",
        "client": {
          "visible": false
        },
        "kind": "do",
        "doneBy": "rules",
        "uses": {
          "type": "skill",
          "skill": "materials.lookup-existing"
        },
        "input": {
          "documentId": "{{trigger.documentId}}"
        }
      },
      {
        "id": "open",
        "name": "Any lines left open?",
        "kind": "fork",
        "paths": [
          {
            "id": "open-path",
            "name": "Some",
            "when": {
              "match": "all",
              "rules": [
                {
                  "field": "{{steps.lookup.output.openCount}}",
                  "op": ">",
                  "value": 0
                }
              ]
            },
            "steps": [
              {
                "id": "match",
                "name": "Match the unmatched",
                "client": {
                  "visible": false
                },
                "kind": "do",
                "doneBy": "ai",
                "uses": {
                  "type": "skill",
                  "skill": "materials.match-unmatched"
                },
                "input": {
                  "lines": "{{steps.lookup.output.open}}"
                }
              },
              {
                "id": "check",
                "name": "Check matches",
                "client": {
                  "visible": false
                },
                "kind": "do",
                "doneBy": "rules",
                "uses": {
                  "type": "skill",
                  "skill": "materials.check-matches"
                },
                "input": {
                  "lines": "{{steps.lookup.output.lines}}",
                  "answers": "{{steps.match.output.answers}}"
                }
              },
              {
                "id": "needs-person",
                "name": "Any line for a person?",
                "kind": "fork",
                "paths": [
                  {
                    "id": "needs-person-path",
                    "name": "Some",
                    "when": {
                      "match": "all",
                      "rules": [
                        {
                          "field": "{{steps.check.output.anyNeedsReview}}",
                          "op": "=",
                          "value": true
                        }
                      ]
                    },
                    "steps": [
                      {
                        "id": "person",
                        "name": "Ask a person about the lines we weren't sure of",
                        "client": {
                          "visible": true,
                          "label": "Asked you about lines we weren't sure of"
                        },
                        "kind": "do",
                        "doneBy": "person",
                        "person": {
                          "mode": "approve",
                          "who": "client_admin",
                          "question": "{{steps.check.output.needsReview}} invoice lines need you",
                          "show": {
                            "documentId": "{{trigger.documentId}}",
                            "lines": "{{steps.check.output.lines}}"
                          },
                          "deadline": {
                            "after": "3 days",
                            "hours": "business",
                            "remind": ["1 day"],
                            "ifNoAnswer": "stop"
                          },
                          "channel": "inbox",
                          "onReject": "stop"
                        }
                      }
                    ]
                  }
                ],
                "otherwise": {
                  "id": "needs-person-none",
                  "steps": []
                }
              },
              {
                "id": "save-open",
                "name": "Save to records: the matches",
                "client": {
                  "visible": false
                },
                "kind": "do",
                "doneBy": "rules",
                "uses": {
                  "type": "action",
                  "action": "materials.matches.record"
                },
                "input": {
                  "lines": "{{steps.check.output.lines}}"
                }
              }
            ]
          }
        ],
        "otherwise": {
          "id": "open-none",
          "steps": [
            {
              "id": "check-settled",
              "name": "Check matches",
              "client": {
                "visible": false
              },
              "kind": "do",
              "doneBy": "rules",
              "uses": {
                "type": "skill",
                "skill": "materials.check-matches"
              },
              "input": {
                "lines": "{{steps.lookup.output.lines}}",
                "answers": []
              }
            },
            {
              "id": "save-settled",
              "name": "Save to records: the matches",
              "client": {
                "visible": false
              },
              "kind": "do",
              "doneBy": "rules",
              "uses": {
                "type": "action",
                "action": "materials.matches.record"
              },
              "input": {
                "lines": "{{steps.check-settled.output.lines}}"
              }
            }
          ]
        }
      },
      {
        "id": "compare",
        "name": "Compare to historicals",
        "client": {
          "visible": false
        },
        "kind": "do",
        "doneBy": "rules",
        "uses": {
          "type": "skill",
          "skill": "materials.compare-prices"
        },
        "input": {
          "documentId": "{{trigger.documentId}}"
        }
      },
      {
        "id": "save-prices",
        "name": "Save to records: the prices",
        "client": {
          "visible": false
        },
        "kind": "do",
        "doneBy": "rules",
        "uses": {
          "type": "action",
          "action": "materials.prices.record"
        },
        "input": {
          "documentId": "{{trigger.documentId}}"
        }
      },
      {
        "id": "alerts",
        "name": "Any alert?",
        "kind": "fork",
        "paths": [
          {
            "id": "alerts-path",
            "name": "Some",
            "when": {
              "match": "all",
              "rules": [
                {
                  "field": "{{steps.compare.output.anyAlerts}}",
                  "op": "=",
                  "value": true
                }
              ]
            },
            "steps": [
              {
                "id": "save-alerts",
                "name": "Save to records: raise the alerts",
                "client": {
                  "visible": true,
                  "label": "Raised price alerts"
                },
                "kind": "do",
                "doneBy": "rules",
                "uses": {
                  "type": "action",
                  "action": "materials.prices.check"
                },
                "input": {
                  "documentId": "{{trigger.documentId}}"
                }
              }
            ]
          }
        ],
        "otherwise": {
          "id": "alerts-none",
          "steps": []
        }
      },
      {
        "id": "end",
        "kind": "end",
        "name": "Done",
        "outputs": ["out-done"]
      }
    ]
  }
}
