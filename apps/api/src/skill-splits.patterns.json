  "A forum reply": {
    "steps": [
      {
        "id": "thread",
        "name": "Read the thread",
        "client": {
          "visible": false
        },
        "kind": "do",
        "doneBy": "rules",
        "uses": {
          "type": "action",
          "action": "hackernews.thread"
        },
        "input": {
          "id": "41000000"
        }
      },
      {
        "id": "write-reply",
        "name": "Write a forum reply",
        "client": {
          "visible": false
        },
        "kind": "do",
        "doneBy": "ai",
        "uses": {
          "type": "skill",
          "skill": "marketing.write-forum-reply"
        },
        "input": {
          "thread": "{{steps.thread.output}}"
        }
      },
      {
        "id": "mark",
        "name": "Save to records: the thread was read",
        "client": {
          "visible": false
        },
        "kind": "do",
        "doneBy": "rules",
        "uses": {
          "type": "action",
          "action": "marketing.forum.thread.mark"
        },
        "input": {
          "id": "41000000",
          "url": "https://news.ycombinator.com/item?id=41000000",
          "title": "Ask HN: approval workflows",
          "outcome": "seen"
        }
      },
      {
        "id": "reply",
        "name": "A reply worth drafting?",
        "kind": "fork",
        "paths": [
          {
            "id": "reply-path",
            "name": "Reply",
            "when": {
              "match": "all",
              "rules": [
                {
                  "field": "{{steps.write-reply.output.decision}}",
                  "op": "=",
                  "value": "reply"
                }
              ]
            },
            "steps": [
              {
                "id": "save-reply",
                "name": "Save to records: the reply for a person to post",
                "client": {
                  "visible": true,
                  "label": "Drafted a forum reply for you to post"
                },
                "kind": "do",
                "doneBy": "rules",
                "uses": {
                  "type": "action",
                  "action": "marketing.forum.reply.draft"
                },
                "input": {
                  "threadId": "{{steps.mark.output.threadId}}",
                  "body": "{{steps.write-reply.output.body}}"
                }
              }
            ]
          }
        ],
        "otherwise": {
          "id": "reply-none",
          "steps": []
        }
      },
      {
        "id": "end",
        "kind": "end",
        "name": "Done",
        "outputs": ["out-done"]
      }
    ]
  },
  "A LinkedIn post": {
    "steps": [
      {
        "id": "report",
        "name": "The report",
        "client": {
          "visible": false
        },
        "kind": "do",
        "doneBy": "rules",
        "uses": {
          "type": "action",
          "action": "marketing.report.get"
        },
        "input": {
          "report": "{{trigger.reportId}}"
        }
      },
      {
        "id": "write-post",
        "name": "Write a LinkedIn post",
        "client": {
          "visible": false
        },
        "kind": "do",
        "doneBy": "ai",
        "uses": {
          "type": "skill",
          "skill": "marketing.write-post"
        },
        "input": {
          "report": "{{steps.report.output}}"
        }
      },
      {
        "id": "check-post",
        "name": "Check the post",
        "client": {
          "visible": false
        },
        "kind": "do",
        "doneBy": "rules",
        "uses": {
          "type": "action",
          "action": "marketing.social.check"
        },
        "input": {
          "text": "{{steps.write-post.output.text}}",
