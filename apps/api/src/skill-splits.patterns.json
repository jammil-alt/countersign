{
  "Read a vendor's quote": {
    "steps": [
      {
        "id": "quote",
        "name": "The lines asked for",
        "client": {
          "visible": false
        },
        "kind": "do",
        "doneBy": "rules",
        "uses": {
          "type": "action",
          "action": "materials.quote.get"
        },
        "input": {
          "quoteRequestId": "{{trigger.quoteRequestId}}"
        }
      },
      {
        "id": "read-quote",
        "name": "Read the vendor's quote",
        "client": {
          "visible": true,
          "label": "Read the vendor's quote"
        },
        "kind": "do",
        "doneBy": "ai",
        "uses": {
          "type": "skill",
          "skill": "materials.read-quote-document"
        },
        "input": {
          "quoteRequestId": "{{trigger.quoteRequestId}}",
          "quote": "{{steps.quote.output}}",
          "documentId": "{{trigger.documentId}}"
        }
      },
      {
        "id": "save-quote",
        "name": "Save to records: the quote",
        "client": {
          "visible": false
        },
        "kind": "do",
        "doneBy": "rules",
        "uses": {
          "type": "action",
          "action": "materials.quote.record"
        },
        "input": {
          "quoteRequestId": "{{trigger.quoteRequestId}}",
          "declined": "{{steps.read-quote.output.declined}}",
          "lines": "{{steps.read-quote.output.lines}}"
        }
      },
      {
        "id": "end",
        "kind": "end",
        "name": "Done",
        "outputs": ["out-done"]
      }
    ]
  },
  "Find duplicate catalog items": {
    "steps": [
      {
        "id": "pairs",
        "name": "Likely duplicates",
        "client": {
          "visible": false
        },
        "kind": "do",
        "doneBy": "rules",
        "uses": {
          "type": "action",
          "action": "materials.catalog.duplicates"
        },
        "input": {}
      },
      {
        "id": "choose",
        "name": "Choose items to merge",
        "client": {
          "visible": false
        },
        "kind": "do",
        "doneBy": "ai",
        "uses": {
          "type": "skill",
          "skill": "materials.choose-merges"
        },
        "input": {
          "pairs": "{{steps.pairs.output.pairs}}"
        }
      },
      {
        "id": "each",
        "name": "Each merge",
        "kind": "for_each",
        "over": "{{steps.choose.output.proposals}}",
        "concurrency": 1,
        "steps": [
          {
            "id": "ask-merge",
            "name": "Save to records: ask the operator to merge",
            "client": {
              "visible": false
            },
            "kind": "do",
            "doneBy": "rules",
            "uses": {
              "type": "action",
              "action": "inbox.create"
            },
            "input": {
              "kind": "review",
              "title": "Merge catalog items",
              "details": "{{item.reason}}",
              "sources": ["{{item.fromId}}", "{{item.intoId}}"],
              "assignee": "operator"
            }
          }
        ]
      },
      {
        "id": "end",
        "kind": "end",
        "name": "Done",
        "outputs": ["out-done"]
      }
    ]
  },
  "Categorize bank transactions": {
    "steps": [
      {
        "id": "open",
        "name": "The open transactions",
        "client": {
          "visible": false
        },
        "kind": "do",
        "doneBy": "rules",
        "uses": {
          "type": "action",
          "action": "bookkeeping.transactions.open"
        },
        "input": {
          "ids": "{{trigger.bankTxnIds}}"
        }
      },
      {
        "id": "chart",
        "name": "The chart of accounts",
        "client": {
          "visible": false
        },
        "kind": "do",
        "doneBy": "rules",
        "uses": {
          "type": "action",
          "action": "ledger.accounts.list"
        },
        "input": {
          "classifications": ["expense", "revenue", "asset", "liability", "equity"]
        }
      },
      {
        "id": "propose",
        "name": "Propose accounts",
        "client": {
          "visible": true,
          "label": "Proposed accounts for new transactions"
        },
        "kind": "do",
        "doneBy": "ai",
        "uses": {
          "type": "skill",
          "skill": "bookkeeping.propose-accounts"
        },
        "input": {
          "transactions": "{{steps.open.output.transactions}}",
          "accounts": "{{steps.chart.output.accounts}}"
        }
      },
      {
        "id": "each-proposal",
        "name": "Each proposal",
        "kind": "for_each",
        "over": "{{steps.propose.output.proposals}}",
        "concurrency": 1,
        "steps": [
          {
            "id": "save-proposal",
            "name": "Save to records: the proposed booking",
            "client": {
              "visible": false
            },
            "kind": "do",
            "doneBy": "rules",
            "uses": {
              "type": "action",
              "action": "bookkeeping.booking.propose"
            },
            "input": {
              "bankTxnId": "{{item.bankTxnId}}",
              "lines": "{{item.lines}}",
              "confidence": "{{item.confidence}}",
              "reason": "{{item.reason}}"
            }
          }
        ]
      },
      {
        "id": "each-note",
        "name": "Each note",
        "kind": "for_each",
        "over": "{{steps.propose.output.notes}}",
        "concurrency": 1,
        "steps": [
          {
            "id": "save-note",
            "name": "Save to records: what the account is for",
            "client": {
              "visible": false
            },
            "kind": "do",
            "doneBy": "rules",
            "uses": {
              "type": "action",
              "action": "bookkeeping.account.note"
            },
            "input": {
              "ledgerAccountId": "{{item.ledgerAccountId}}",
              "note": "{{item.note}}",
              "sources": "{{item.sources}}"
            }
          }
        ]
      },
      {
        "id": "end",
        "kind": "end",
        "name": "Done",
        "outputs": ["out-done"]
      }
    ]
  },
  "Explain what a reconciliation left": {
    "steps": [
      {
        "id": "recon",
        "name": "The reconciliation",
        "client": {
          "visible": false
        },
        "kind": "do",
        "doneBy": "rules",
        "uses": {
          "type": "action",
          "action": "bookkeeping.reconcile.open"
        },
        "input": {
          "reconciliationId": "{{trigger.reconciliationId}}"
        }
      },
      {
        "id": "suggest",
        "name": "Suggest matches for what is left",
        "client": {
          "visible": false
        },
        "kind": "do",
        "doneBy": "ai",
        "uses": {
          "type": "skill",
          "skill": "bookkeeping.suggest-matches"
        },
        "input": {
          "reconciliation": "{{steps.recon.output}}"
        }
      },
      {
        "id": "each-match",
        "name": "Each suggestion",
        "kind": "for_each",
        "over": "{{steps.suggest.output.proposals}}",
        "concurrency": 1,
        "steps": [
          {
            "id": "save-match",
            "name": "Save to records: the suggested match",
            "client": {
              "visible": false
            },
            "kind": "do",
            "doneBy": "rules",
            "uses": {
              "type": "action",
              "action": "bookkeeping.reconcile.propose"
            },
            "input": {
              "reconciliationId": "{{trigger.reconciliationId}}",
              "aItemIds": "{{item.aItemIds}}",
              "bItemIds": "{{item.bItemIds}}",
              "reason": "{{item.reason}}",
              "confidence": "{{item.confidence}}"
            }
          }
        ]
      },
      {
        "id": "end",
        "kind": "end",
        "name": "Done",
        "outputs": ["out-done"]
      }
    ]
  },
  "The weekly site report": {
    "steps": [
      {
        "id": "figures",
        "name": "The week's figures",
        "client": {
          "visible": false
        },
        "kind": "do",
        "doneBy": "rules",
        "uses": {
          "type": "action",
          "action": "marketing.site.figures"
        },
        "input": {}
      },
      {
        "id": "write-report",
        "name": "Write the weekly report",
        "client": {
          "visible": false
        },
        "kind": "do",
        "doneBy": "ai",
        "uses": {
          "type": "skill",
          "skill": "marketing.write-report"
        },
        "input": {
          "figures": "{{steps.figures.output}}"
        }
      },
      {
        "id": "save-report",
        "name": "Save to records: the report",
        "client": {
          "visible": true,
          "label": "Wrote the weekly site report"
        },
        "kind": "do",
        "doneBy": "rules",
        "uses": {
          "type": "action",
          "action": "marketing.report.record"
        },
        "input": {
          "report": "{{steps.write-report.output.report}}",
          "sources": "{{steps.figures.output.sourcesIds}}"
