{
  "name": "@countersign/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, migrations, seed, typed queries, tenant-scoped transactions",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./seed": "./src/seed.ts",
    "./purge": "./src/purge.ts",
    "./seed/agents/*": "./seed/agents/*"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "db:add-operator": "tsx scripts/add-operator.ts",
    "db:remove-operator": "tsx scripts/remove-operator.ts",
    "db:purge-client": "tsx scripts/purge-client.ts"
  },
  "dependencies": {
    "@countersign/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^4.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.15"
  }
}
