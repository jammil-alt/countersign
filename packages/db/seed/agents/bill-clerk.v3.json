{
  "extends": 2,
  "definition": {
    "skills": [
      {
        "skill": "qbo.choose-invoice-lines",
        "settings": {},
        "model": {
          "id": "claude-haiku-5-5"
        }
      },
      {
        "skill": "docs.prepare-bill",
        "settings": {}
      },
      {
        "skill": "docs.check-bill",
        "settings": {}
      }
    ],
    "extraTools": [
      "docs.match_bill",
      "docs.get",
      "qbo.bill.query",
      "docs.plan_bill",
      "docs.bill_lines",
      "qbo.vendor.query",
      "qbo.account.query",
      "qbo.bill.update_lines",
      "qbo.attachable.upload",
      "qbo.bill.update_memo"
    ]
  },
  "workflows": [
    {
      "slug": "invoice-read",
      "name": "When an invoice has been read",
      "workflow": {
        "schemaVersion": 4,
        "triggers": [
          {
            "id": "trg-invoice-read",
            "on": {
              "type": "event",
              "event": "document.extracted",
              "filter": {
                "match": "all",
                "rules": [
                  {
                    "field": "{{trigger.totalsValid}}",
                    "op": "is",
                    "value": true
                  }
                ]
              }
            }
          }
        ],
        "steps": [
          {
            "id": "match",
            "name": "Find the bill",
            "client": {
              "visible": true,
              "label": "Looked for the bill in QuickBooks"
            },
            "kind": "read",
            "tool": "docs.match_bill",
            "input": {
              "documentId": "{{trigger.documentId}}",
              "connector": "qbo",
              "windowDays": 7
            }
          },
          {
            "id": "invoice",
            "name": "Read the invoice as read",
            "client": {
              "visible": false
            },
            "kind": "read",
            "tool": "docs.get",
            "input": {
              "documentId": "{{trigger.documentId}}"
            }
          },
          {
            "id": "matched",
            "name": "One bill matches?",
            "client": {
              "visible": false
            },
            "kind": "if",
            "paths": [
              {
                "id": "path-matched",
                "name": "One bill matches",
                "when": {
                  "match": "all",
                  "rules": [
                    {
                      "field": "{{steps.match.output.status}}",
                      "op": "=",
                      "value": "matched"
                    }
                  ]
                },
                "steps": [
                  {
                    "id": "bill",
                    "name": "Read the bill",
                    "client": {
                      "visible": false
                    },
                    "kind": "read",
                    "tool": "qbo.bill.query",
                    "input": {
                      "ids": ["{{steps.match.output.bill.recordId}}"]
                    }
                  },
                  {
                    "id": "plan",
                    "name": "Check the bill against the invoice",
                    "client": {
                      "visible": true,
                      "label": "Checked the bill against the invoice"
                    },
                    "kind": "read",
                    "tool": "docs.plan_bill",
                    "input": {
                      "documentId": "{{trigger.documentId}}",
                      "bill": "{{steps.bill.output.bills.0}}",
                      "transactionId": "{{steps.match.output.bill.transactionId}}"
                    }
                  },
                  {
                    "id": "decide",
                    "name": "What the bill needs",
                    "client": {
                      "visible": false
                    },
                    "kind": "if",
                    "paths": [
                      {
                        "id": "path-itemize",
                        "name": "Itemize it",
                        "when": {
                          "match": "all",
                          "rules": [
                            {
                              "field": "{{steps.plan.output.decision}}",
                              "op": "=",
                              "value": "itemize"
                            }
                          ]
                        },
                        "steps": [
                          {
                            "id": "map",
                            "name": "Choose items and accounts",
                            "client": {
                              "visible": false
                            },
                            "kind": "skill",
                            "skill": "qbo.choose-invoice-lines",
                            "input": {
                              "invoice": "{{steps.invoice.output.extraction}}",
                              "bill": "{{steps.bill.output.bills.0}}"
                            }
                          },
                          {
                            "id": "lines",
                            "name": "Lay out the lines",
                            "client": {
                              "visible": false
                            },
                            "kind": "read",
                            "tool": "docs.bill_lines",
                            "input": {
                              "documentId": "{{trigger.documentId}}",
                              "bill": "{{steps.bill.output.bills.0}}",
                              "choices": "{{steps.map.output.lines}}"
                            }
                          },
                          {
                            "id": "itemize",
                            "name": "Itemize the bill",
                            "client": {
                              "visible": true,
                              "label": "Itemized the bill"
                            },
                            "kind": "write",
                            "tool": "qbo.bill.update_lines",
                            "input": {
                              "id": "{{steps.lines.output.id}}",
                              "syncToken": "{{steps.lines.output.syncToken}}",
                              "expectedTotal": "{{steps.lines.output.expectedTotal}}",
                              "currency": "{{steps.lines.output.currency}}",
                              "replaceLineIds": "{{steps.lines.output.replaceLineIds}}",
                              "lines": "{{steps.lines.output.lines}}"
                            },
                            "checks": {
                              "approval": {
                                "required": "required",
                                "mode": "in_turn",
                                "ifNoAnswer": "stop"
                              }
                            }
                          },
                          {
                            "id": "attach-needed",
                            "name": "Invoice not attached yet?",
                            "client": {
                              "visible": false
                            },
                            "kind": "if",
                            "paths": [
                              {
                                "id": "path-attach",
                                "name": "Attach it",
                                "when": {
                                  "match": "all",
                                  "rules": [
                                    {
                                      "field": "{{steps.plan.output.attach}}",
                                      "op": "is",
                                      "value": true
                                    }
                                  ]
                                },
                                "steps": [
                                  {
                                    "id": "attach",
                                    "name": "Attach the invoice",
                                    "client": {
                                      "visible": true,
                                      "label": "Attached the invoice"
                                    },
                                    "kind": "write",
                                    "tool": "qbo.attachable.upload",
                                    "input": {
                                      "documentId": "{{trigger.documentId}}",
                                      "entity": "Bill",
                                      "entityId": "{{steps.bill.output.bills.0.id}}"
                                    },
                                    "checks": {
                                      "approval": {
                                        "required": "required",
                                        "mode": "in_turn",
                                        "ifNoAnswer": "stop"
                                      }
                                    }
                                  }
                                ]
                              }
                            ],
                            "otherwise": {
                              "id": "path-attached",
                              "steps": []
                            }
                          },
                          {
                            "id": "memo-needed",
                            "name": "Bill has no memo?",
                            "client": {
                              "visible": false
                            },
                            "kind": "if",
                            "paths": [
                              {
                                "id": "path-memo",
                                "name": "Set the memo",
                                "when": {
                                  "match": "all",
                                  "rules": [
                                    {
                                      "field": "{{steps.plan.output.setMemo}}",
                                      "op": "is",
                                      "value": true
                                    }
                                  ]
                                },
                                "steps": [
                                  {
                                    "id": "reread",
                                    "name": "Read the bill again",
                                    "client": {
                                      "visible": false
                                    },
                                    "kind": "read",
                                    "tool": "qbo.bill.query",
                                    "input": {
                                      "ids": ["{{steps.bill.output.bills.0.id}}"]
                                    }
                                  },
                                  {
                                    "id": "memo",
                                    "name": "Note the invoice on the bill",
                                    "client": {
                                      "visible": true,
                                      "label": "Noted the invoice on the bill"
                                    },
                                    "kind": "write",
                                    "tool": "qbo.bill.update_memo",
                                    "input": {
                                      "id": "{{steps.reread.output.bills.0.id}}",
                                      "syncToken": "{{steps.reread.output.bills.0.syncToken}}",
                                      "memo": "{{steps.plan.output.memo}}"
                                    },
                                    "checks": {
                                      "approval": {
                                        "required": "required",
                                        "mode": "in_turn",
                                        "ifNoAnswer": "stop"
                                      }
                                    }
                                  }
                                ]
                              }
                            ],
                            "otherwise": {
                              "id": "path-has-memo",
                              "steps": []
                            }
                          },
                          {
                            "id": "done",
                            "name": "Say what changed",
                            "client": {
                              "visible": true,
                              "label": "Told you what changed"
                            },
                            "kind": "notify",
                            "notify": {
                              "to": ["client_admin"],
                              "channel": "inbox",
                              "message": "Bill {{steps.plan.output.billNumber}} now has the {{steps.plan.output.invoiceLineCount}} lines of {{steps.plan.output.vendorName}} invoice {{steps.plan.output.invoiceNumber}}. The total is unchanged at {{steps.plan.output.billTotal}} {{steps.plan.output.currency}}.",
                              "sources": ["{{steps.plan.output.sources}}"]
                            }
                          }
                        ]
                      },
                      {
                        "id": "path-nothing",
                        "name": "Nothing to change",
                        "when": {
                          "match": "all",
                          "rules": [
                            {
                              "field": "{{steps.plan.output.decision}}",
                              "op": "=",
                              "value": "nothing_to_do"
                            }
                          ]
                        },
                        "steps": [
                          {
                            "id": "nothing",
                            "name": "Say it matches",
                            "client": {
                              "visible": true,
                              "label": "Found the bill already done"
                            },
                            "kind": "notify",
                            "notify": {
                              "to": ["client_admin"],
                              "channel": "inbox",
                              "message": "{{steps.plan.output.vendorName}} invoice {{steps.plan.output.invoiceNumber}} matches bill {{steps.plan.output.billNumber}}. {{steps.plan.output.reason}} Nothing to change.",
                              "sources": ["{{steps.plan.output.sources}}"]
                            }
                          }
                        ]
                      }
                    ],
                    "otherwise": {
                      "id": "path-plan-person",
                      "steps": [
                        {
                          "id": "cant-itemize",
                          "name": "Ask about the bill",
                          "client": {
                            "visible": true,
                            "label": "Asked you about the bill"
                          },
                          "kind": "person",
                          "mode": "ask",
                          "assignee": "client_admin",
                          "title": "We matched invoice {{steps.plan.output.invoiceNumber}} to bill {{steps.plan.output.billNumber}} but changed nothing",
                          "payload": {
                            "reason": "{{steps.plan.output.reason}}",
                            "sources": "{{steps.plan.output.sources}}"
                          },
                          "deadline": {
                            "after": "7 days",
                            "hours": "clock",
                            "ifNoAnswer": "proceed"
                          },
                          "channel": "inbox"
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "id": "path-none",
                "name": "No bill yet",
                "when": {
                  "match": "all",
                  "rules": [
                    {
                      "field": "{{steps.match.output.status}}",
                      "op": "=",
                      "value": "none"
                    }
                  ]
                },
                "steps": [
                  {
                    "id": "vendor",
                    "name": "Find the vendor in QuickBooks",
                    "client": {
                      "visible": false
                    },
                    "kind": "read",
                    "tool": "qbo.vendor.query",
                    "input": {
                      "name": "{{steps.match.output.invoice.vendorName}}"
                    }
                  },
                  {
                    "id": "vendor-found",
                    "name": "Vendor found?",
                    "client": {
                      "visible": false
                    },
                    "kind": "if",
                    "paths": [
                      {
                        "id": "path-vendor-found",
                        "name": "Found",
                        "when": {
                          "match": "all",
                          "rules": [
                            {
                              "field": "{{steps.vendor.output.vendors.0.id}}",
                              "op": "exists"
                            }
                          ]
                        },
                        "steps": [
                          {
                            "id": "accounts",
                            "name": "Read the expense accounts",
                            "client": {
                              "visible": false
                            },
                            "kind": "read",
                            "tool": "qbo.account.query",
                            "input": {
                              "types": ["Expense", "Cost of Goods Sold"]
                            }
                          },
                          {
                            "id": "prepare",
                            "name": "Prepare bill",
                            "client": {
                              "visible": false
                            },
                            "kind": "skill",
                            "skill": "docs.prepare-bill",
                            "input": {
                              "invoice": "{{steps.invoice.output.extraction}}",
                              "vendors": "{{steps.vendor.output.vendors}}",
                              "accounts": "{{steps.accounts.output.accounts}}"
                            }
                          },
                          {
                            "id": "check-bill",
                            "name": "Check bill",
                            "client": {
                              "visible": false
                            },
                            "kind": "skill",
                            "skill": "docs.check-bill",
                            "input": {
                              "bill": "{{steps.prepare.output}}",
                              "invoice": "{{steps.invoice.output.extraction}}",
                              "vendors": "{{steps.vendor.output.vendors}}",
                              "accounts": "{{steps.accounts.output.accounts}}"
                            }
                          },
                          {
                            "id": "bill-checked",
                            "name": "Bill matches the invoice?",
                            "client": {
                              "visible": false
                            },
                            "kind": "if",
                            "paths": [
                              {
                                "id": "path-bill-ok",
                                "name": "It matches",
                                "when": {
                                  "match": "all",
                                  "rules": [
                                    {
                                      "field": "{{steps.check-bill.output.ok}}",
                                      "op": "is",
                                      "value": true
                                    }
                                  ]
                                },
                                "steps": [
                                  {
                                    "id": "create",
                                    "name": "Create bill",
                                    "client": {
                                      "visible": true,
                                      "label": "Added the bill"
                                    },
                                    "kind": "write",
                                    "action": "create_bill",
                                    "input": {
                                      "vendorId": "{{steps.prepare.output.vendorId}}",
                                      "invoiceNumber": "{{steps.prepare.output.invoiceNumber}}",
                                      "date": "{{steps.prepare.output.date}}",
                                      "dueDate": "{{steps.prepare.output.dueDate}}",
                                      "lines": "{{steps.prepare.output.lines}}",
                                      "total": "{{steps.prepare.output.total}}",
                                      "currency": "{{steps.prepare.output.currency}}",
                                      "memo": "{{steps.prepare.output.memo}}"
                                    },
                                    "checks": {
                                      "approval": {
                                        "required": "required",
                                        "mode": "in_turn",
                                        "ifNoAnswer": "stop"
                                      }
                                    }
                                  },
                                  {
                                    "id": "created",
                                    "name": "Say the bill was added",
                                    "client": {
                                      "visible": true,
                                      "label": "Told you about the new bill"
                                    },
                                    "kind": "notify",
                                    "notify": {
                                      "to": ["client_admin"],
                                      "channel": "inbox",
                                      "message": "We added bill {{steps.prepare.output.invoiceNumber}} from {{steps.match.output.invoice.vendorName}} for {{steps.prepare.output.total}} {{steps.prepare.output.currency}}, with its {{steps.prepare.output.lines.length}} lines.",
                                      "sources": ["{{steps.prepare.output.sources}}"]
                                    }
                                  }
                                ]
                              }
                            ],
                            "otherwise": {
                              "id": "path-bill-differs",
                              "steps": [
                                {
                                  "id": "bill-differs",
                                  "name": "Ask about the bill we prepared",
                                  "client": {
                                    "visible": true,
                                    "label": "Asked you about the new bill"
                                  },
                                  "kind": "person",
                                  "mode": "ask",
                                  "assignee": "client_admin",
                                  "title": "The bill we prepared for invoice {{steps.match.output.invoice.number}} from {{steps.match.output.invoice.vendorName}} doesn't match the invoice, so we didn't add it",
                                  "payload": {
                                    "problems": "{{steps.check-bill.output.problems}}",
                                    "sources": "{{steps.check-bill.output.sources}}"
                                  },
                                  "deadline": {
                                    "after": "7 days",
                                    "hours": "clock",
                                    "ifNoAnswer": "proceed"
                                  },
                                  "channel": "inbox"
                                }
                              ]
                            }
                          }
                        ]
                      }
                    ],
                    "otherwise": {
                      "id": "path-no-vendor",
                      "steps": [
                        {
                          "id": "no-vendor",
                          "name": "Ask about the vendor",
                          "client": {
                            "visible": true,
                            "label": "Asked you about the vendor"
                          },
                          "kind": "person",
                          "mode": "ask",
                          "assignee": "client_admin",
                          "title": "We found no bill and no vendor named {{steps.match.output.invoice.vendorName}} in QuickBooks for invoice {{steps.match.output.invoice.number}}",
                          "payload": {
                            "reason": "{{steps.match.output.reason}}",
                            "sources": "{{steps.match.output.sources}}"
                          },
                          "deadline": {
                            "after": "7 days",
                            "hours": "clock",
                            "ifNoAnswer": "proceed"
                          },
                          "channel": "inbox"
                        }
                      ]
                    }
                  }
                ]
              }
            ],
            "otherwise": {
              "id": "path-no-match",
              "steps": [
                {
                  "id": "no-match",
                  "name": "Ask which bill",
                  "client": {
                    "visible": true,
                    "label": "Asked you which bill it is"
                  },
                  "kind": "person",
                  "mode": "ask",
                  "assignee": "client_admin",
                  "title": "We couldn't match invoice {{steps.match.output.invoice.number}} from {{steps.match.output.invoice.vendorName}} to a bill",
                  "payload": {
                    "reason": "{{steps.match.output.reason}}",
                    "candidates": "{{steps.match.output.candidates}}",
                    "sources": "{{steps.match.output.sources}}"
                  },
                  "deadline": {
                    "after": "7 days",
                    "hours": "clock",
                    "ifNoAnswer": "proceed"
                  },
                  "channel": "inbox"
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
