{
  "name": "countersign",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @countersign/web run --if-present build && pnpm --filter @countersign/api run --if-present dev",
    "dev:web": "pnpm --filter @countersign/web run --if-present dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "lint:deps": "node scripts/check-deps.mjs && node --test scripts/check-deps.test.mjs scripts/vuln-sla.test.mjs",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm lint:deps && pnpm typecheck && pnpm test",
    "db:up": "docker compose up -d --wait postgres",
    "db:seed": "pnpm --filter @countersign/db run db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@opentelemetry/api": "1.10.0",
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
