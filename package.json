{
  "name": "countersign",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @countersign/web build && pnpm --filter @countersign/api dev",
    "dev:web": "pnpm --filter @countersign/web dev",
    "typecheck": "pnpm -r typecheck",
    "lint:deps": "node scripts/check-deps.mjs",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d postgres"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
